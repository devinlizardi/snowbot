# Copy to .env and fill in. .env is gitignored and must stay that way.
# Identifiers are safe to commit; tokens and keys are NOT.

# --- Discord ---
DISCORD_BOT_TOKEN=            # secret, from the Developer Portal (shown once)
DISCORD_APP_ID=
DISCORD_GUILD_ID=789740830935482418        # real guild (Elliot's) — bot not invited yet
DISCORD_CHANNEL_ID=839965873808343101      # real channel
DISCORD_TEST_GUILD_ID=260572317921443840   # dev guild
DISCORD_TEST_CHANNEL_ID=1547643758710104124

# Optional: member Discord IDs, used to @-mention people in the arrivals table.
DISCORD_USER_DEVIN=
DISCORD_USER_ANDRE=
DISCORD_USER_ELLIOT=
DISCORD_USER_JEREMY=
DISCORD_USER_HAGEN=

# --- Google Cloud / WeatherNext 3 ---
GCP_PROJECT_ID=project-8e521677-4290-4d50-9b7
# The Analytics Hub LINKED DATASET name you chose when subscribing — not a table
# name. The two tables inside it are weathernext_3_0_0_0p1deg / _0p05deg and are
# set in config.yaml, not here.
GCP_DATASET_ID=weathernext_3
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp.json

# Optional fallback if BigQuery access lapses (weather.weathernext_provider: maps)
GOOGLE_MAPS_WEATHER_API_KEY=

# --- Paid APIs ---
ANTHROPIC_API_KEY=
SERPAPI_KEY=
FLIGHTAWARE_API_KEY=

# --- Runtime ---
NODE_ENV=production
SNOWBOT_DB_PATH=./data/snowbot.sqlite
LOG_LEVEL=info
